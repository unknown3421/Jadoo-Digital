{
  "version": 2,
  "builds": [
    {
      "src": "api/*.php",
      "use": "@vercel/php"
    },
    {
      "src": "index.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/api/.*",
      "dest": "/api.php"
    },
    {
      "src": "/.*",
      "dest": "/index.php"
    }
  ]
}
